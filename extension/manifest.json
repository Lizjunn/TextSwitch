{
  "manifest_version": 3,
  "name": "简繁切换 · TextSwitch",
  "version": "1.0.2",
  "description": "选中中文，一键切换简体或繁体。预览并复制结果，也可直接替换输入框中选中的文字。完全离线。",
  "minimum_chrome_version": "110",
  "permissions": ["contextMenus", "storage", "clipboardWrite", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "简繁切换",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["vendor/opencc.js", "shared.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
